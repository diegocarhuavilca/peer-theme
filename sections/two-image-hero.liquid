<div class="collage-fotos-viewer">
  {% if product.metafields.custom.collage_fotos.value %}
    <h2>Collage de Fotos</h2>
    <div class="image-grid">
      {% for item in product.metafields.custom.collage_fotos.value %}
        {% assign image_url = '' %}
        {% assign image_alt = 'Collage image' %}
        {% if item.src %}
          {% assign image_url = item.src | img_url: '1024x' %} {# Adjust size as needed #}
          {% if item.alt %}
            {% assign image_alt = item.alt %}
          {% endif %}
        {% elsif item contains 'http' or item contains '/' %}
          {% assign image_url = item | img_url: '1024x' %} {# Adjust size as needed #}
        {% endif %}
        {% if image_url != '' %}
          <div class="image-item">
            <img src="{{ image_url }}" alt="{{ image_alt }}" loading="lazy">
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <p>No hay imágenes disponibles en el collage.</p>
  {% endif %}
</div>

<style>
  .collage-fotos-viewer {
    margin-top: 20px;
  }
  .collage-fotos-viewer h2 {
    margin-bottom: 15px;
  }
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); /* Responsive grid */
    gap: 15px;
  }
  .image-item {
    text-align: center;
  }
  .image-item img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>