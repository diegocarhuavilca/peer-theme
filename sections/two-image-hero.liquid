<div class="collage-fotos-viewer">
  {% if product.metafields.custom.collage_fotos.value %}
    <div class="image-grid">
      {% for item in product.metafields.custom.collage_fotos.value %}
        {% assign image_url = '' %}
        {% assign image_alt = 'Collage image' %}
        {% if item.src %}
          {% assign image_url = item.src | img_url: '1024x' %}
          {% if item.alt %}
            {% assign image_alt = item.alt %}
          {% endif %}
        {% elsif item contains 'http' or item contains '/' %}
          {% assign image_url = item | img_url: '1024x' %}
        {% endif %}
        {% if image_url != '' %}
          <div class="image-item">
            <img src="{{ image_url }}" alt="{{ image_alt }}" loading="lazy">
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <p>No hay imágenes disponibles en el collage.</p>
  {% endif %}
</div>

<style>
  .collage-fotos-viewer {
    margin-top: 20px;
  }
  .collage-fotos-viewer h2 {
    margin-bottom: 15px;
  }
  .image-grid {
    display: grid;
    /* Updated for a maximum of 2 columns */
    grid-template-columns: repeat(auto-fit, minmax(calc(50% - 15px), 1fr)); /* 2 columns max */ /* Added gap for spacing between images */
  }
  /* Optional: Adjust for smaller screens to allow fewer than 2 columns if needed */
  @media (max-width: 768px) {
    .image-grid {
      grid-template-columns: repeat(auto-fit, minmax(calc(100% - 15px), 1fr)); /* 1 column on small screens */
    }
  }
  .image-item {
    text-align: center;
    /* This creates a container with a fixed aspect ratio for the image */
    position: relative;
    padding-bottom:  56.25%; /* Adjust this value for your desired image aspect ratio (e.g., 75% for 4:3, 56.25% for 16:9, 100% for 1:1 square) */
    height: 0; /* Important for padding-bottom trick */
    overflow: hidden; /* Hides anything that overflows the container */
  }
  .image-item img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* This is the key: makes images cover the area, cropping if necessary */
    display: block;
  }
</style>