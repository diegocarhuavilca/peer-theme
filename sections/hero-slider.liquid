<div class="hero-slider swiper-container">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide relative">
        {% assign video_url = block.settings.video_url %}
        {% if video_url contains '.mp4' %}
          <video class="w-full h-full object-cover" style="width:100%;object-fit:cover; background-color: black;" preload="auto" muted playsinline>
            <source src="{{ video_url }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% elsif video_url contains 'youtube.com' or video_url contains 'vimeo.com' %}
          {% comment %}
            For YouTube/Vimeo, autoplay and looping behavior is controlled by their embed parameters.
            We'll add parameters for autoplay, mute, and loop for a better experience.
          {% endcomment %}
          {% assign youtube_id = video_url | split: 'v=' | last | split: '&' | first %}
          {% assign vimeo_id = video_url | split: '/' | last %}

          {% if youtube_id %}
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/{{ youtube_id }}?autoplay=1&mute=1&loop=1&playlist={{ youtube_id }}&controls=0&showinfo=0&autohide=1&modestbranding=1&enablejsapi=1"
              frameborder="0"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {% elsif vimeo_id %}
            <iframe
              class="w-full h-full"
              src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&loop=1&muted=1&background=1&api=1"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {% endif %}
        {% elsif block.settings.image %}
          <img
            src="{{ block.settings.image | img_url: '1600x' }}"
            alt="{{ block.settings.heading }}"
            class="w-full h-full object-cover"
            width="100%"
            height="60vh"
            style="width:100%;object-fit:cover;height:60vh"
          >
        {% endif %}

        <div style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2rem; color: white;">
          <h2 style="font-size: 2.25rem; font-weight: 700;">{{ block.settings.heading }}</h2>
          <p style="margin-top: 0.5rem; font-size: 1.125rem;">{{ block.settings.subheading }}</p>
          {% if block.settings.button_link %}
            <a href="{{ block.settings.button_link }}" style="margin-top: 1rem; display: inline-block; background-color: transparent; color: white;border:1px solid white; padding: 0.5rem 1.5rem; border-radius: 0.25rem;text-decoration:none">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="swiper-pagination"></div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
</div>

<script async src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiperContainer = document.querySelector('.hero-slider');
    let ytPlayer = null; // To store YouTube API player object
    let vimeoPlayer = null; // To store Vimeo API player object

    const swiper = new Swiper(swiperContainer, {
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      on: {
        init: function () {
          // Play initial video if it's an MP4 or initialize iframe
          const initialSlide = this.slides[this.activeIndex];
          playVideoInSlide(initialSlide);
        },
        slideChangeTransitionStart: function () {
          const currentSlide = this.slides[this.activeIndex];
          const prevSlide = this.slides[this.previousIndex];

          // Pause videos on the previous slide
          if (prevSlide) {
            pauseVideoInSlide(prevSlide);
          }

          // Play video on the current slide
          playVideoInSlide(currentSlide);
        },
        // We'll manage MP4 looping with a dedicated event listener
      }
    });

    // Centralized function to play video in a given slide
    function playVideoInSlide(slide) {
      if (!slide) return;

      const video = slide.querySelector('video');
      const iframe = slide.querySelector('iframe');

      if (video) {
        // For MP4 videos, wait for 'canplaythrough' event
        if (video.readyState >= 3) { // Check if enough data is loaded
          video.currentTime = 0;
          video.play().catch(error => console.error("Video autoplay failed (ready state):", error));
        } else {
          // If not ready, listen for 'canplaythrough' to ensure smooth start
          video.addEventListener('canplaythrough', function handler() {
            video.currentTime = 0;
            video.play().catch(error => console.error("Video autoplay failed (canplaythrough):", error));
            video.removeEventListener('canplaythrough', handler); // Remove listener after playing
          });
          video.load(); // Ensure video loading starts if not already
        }
      } else if (iframe) {
        const src = iframe.src;
        if (src.includes('youtube.com')) {
          initializeYouTubePlayer(iframe);
        } else if (src.includes('vimeo.com')) {
          initializeVimeoPlayer(iframe);
        }
      }
    }

    // Centralized function to pause video in a given slide
    function pauseVideoInSlide(slide) {
      if (!slide) return;

      const video = slide.querySelector('video');
      const iframe = slide.querySelector('iframe');

      if (video) {
        video.pause();
        video.currentTime = 0; // Reset for next time it's active
      } else if (iframe) {
        const src = iframe.src;
        if (src.includes('youtube.com') && ytPlayer) {
          ytPlayer.pauseVideo();
        } else if (src.includes('vimeo.com') && vimeoPlayer) {
          vimeoPlayer.pause();
        }
      }
    }

    // MP4 Looping: Use 'ended' event with a slight delay
    swiperContainer.querySelectorAll('video').forEach(video => {
      video.addEventListener('ended', function() {
        // Add a very small timeout to allow browser to reset its rendering
        setTimeout(() => {
          this.currentTime = 0;
          this.play().catch(error => console.error("Video loop play failed:", error));
        }, 50); // 50ms delay
      });
    });

    // --- YouTube API Integration ---
    function initializeYouTubePlayer(iframe) {
      if (typeof YT === 'undefined' || !YT.Player) {
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        window.onYouTubeIframeAPIReady = function() {
          ytPlayer = new YT.Player(iframe, {
            events: {
              'onReady': onYouTubePlayerReady,
              'onStateChange': onYouTubePlayerStateChange
            }
          });
        };
      } else if (!ytPlayer || ytPlayer.getIframe() !== iframe) { // Ensure correct player instance for current iframe
        ytPlayer = new YT.Player(iframe, {
          events: {
            'onReady': onYouTubePlayerReady,
            'onStateChange': onYouTubePlayerStateChange
          }
        });
      } else {
        // If player already exists for this iframe, just ensure it plays
        ytPlayer.mute();
        ytPlayer.playVideo();
      }
    }

    function onYouTubePlayerReady(event) {
      event.target.mute(); // Ensure muted
      event.target.playVideo();
    }

    function onYouTubePlayerStateChange(event) {
      if (event.data === YT.PlayerState.ENDED) {
        // Small delay for YouTube loop
        setTimeout(() => {
          event.target.seekTo(0);
          event.target.playVideo();
        }, 50);
      } else if (event.data === YT.PlayerState.PAUSED) {
        // Prevent accidental pause from user interaction if autoplay is desired
        // event.target.playVideo(); // Uncomment if you want to force continuous play even if user pauses
      }
    }

    // --- Vimeo API Integration ---
    function initializeVimeoPlayer(iframe) {
      if (typeof Vimeo === 'undefined' || !Vimeo.Player) {
        const tag = document.createElement('script');
        tag.src = "https://player.vimeo.com/api/player.js";
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        tag.onload = function() {
          vimeoPlayer = new Vimeo.Player(iframe);
          vimeoPlayer.ready().then(function() {
            vimeoPlayer.setVolume(0); // Ensure muted
            vimeoPlayer.play().catch(error => console.error("Vimeo autoplay failed:", error));
          });
        };
      } else if (!vimeoPlayer || vimeoPlayer.element !== iframe) { // Ensure correct player instance for current iframe
        vimeoPlayer = new Vimeo.Player(iframe);
        vimeoPlayer.ready().then(function() {
          vimeoPlayer.setVolume(0); // Ensure muted
          vimeoPlayer.play().catch(error => console.error("Vimeo autoplay failed:", error));
        });
      } else {
        // If player already exists for this iframe, just ensure it plays
        vimeoPlayer.setVolume(0);
        vimeoPlayer.play();
      }
    }
  });
</script>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (fallback if no video)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (mp4, YouTube, or Vimeo)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Slide Title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Your slide description"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Hero Slider",
      "category": "Hero"
    }
  ]
}
{% endschema %}